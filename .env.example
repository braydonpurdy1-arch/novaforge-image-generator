# Server. The safe local default only accepts loopback connections.
HOST=127.0.0.1
PORT=8787

# Authentication modes:
# - token: require NOVAFORGE_SERVICE_TOKEN on REST and MCP requests (default)
# - tunnel: only trust loopback requests from a local Secure MCP Tunnel
NOVA_AUTH_MODE=token
NOVAFORGE_SERVICE_TOKEN=

# Paid/external generation stays disabled until the owner enables it.
NOVAFORGE_WRITE_ENABLED=false

# Wan 3.0 / Alibaba Cloud Model Studio. Keep the key in the deployment secret store.
WAN3_ENABLED=false
WAN3_REGION=singapore
WAN3_WORKSPACE_ID=
WAN3_MODEL=wan3.0-video
DASHSCOPE_API_KEY=
# Optional endpoint override for a supported Model Studio region.
WAN3_BASE_URL=

# Lumina's documented API path is BytePlus ModelArk with Seedance.
LUMINA_ENABLED=false
LUMINA_MODEL=dreamina-seedance-2-5-260628
LUMINA_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_ARK_API_KEY=

# COG-inspired Markdown memory. Proposals are non-persistent; commits require both
# this flag and confirmed=true on the individual call.
NOVAFORGE_MEMORY_WRITE_ENABLED=false
NOVA_MEMORY_DIR=./data/second-brain
